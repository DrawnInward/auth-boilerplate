{
  "name": "@auth-boilerplate/shared",
  "version": "1.0.0",
  "description": "Shared types and schemas for auth-boilerplate",
  "type": "commonjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist-cjs/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.cjs.json",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist",
    "dist-cjs"
  ],
  "dependencies": {
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
