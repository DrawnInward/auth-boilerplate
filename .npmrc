# Supply-chain defence: no package's lifecycle scripts run at install time —
# install scripts are the primary execution vector for npm supply-chain worms
# (see docs/hardening-plan.md, "Supply chain"). Consequences:
#   - `npm ci` / `npm install` never execute third-party code.
#   - No install hook builds packages/shared (there is deliberately no root
#     `prepare`: it could never fire here and only misled). `npm run setup`
#     builds it explicitly; run `npm run build:shared` after pulling changes
#     to packages/shared.
#   - Native modules that genuinely need their scripts are rebuilt explicitly
#     via `npm run rebuild:native` — an allowlist, reviewed like code.
ignore-scripts=true
