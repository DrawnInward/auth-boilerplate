{
  "name": "auth-boilerplate",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @auth-boilerplate/api",
    "dev:web": "npm run dev -w @auth-boilerplate/web",
    "build": "npm run build --workspaces --if-present",
    "build:shared": "npm run build -w @auth-boilerplate/shared",
    "prepare": "npm run build:shared",
    "test": "npm run test -w @auth-boilerplate/api",
    "test:web": "npm run test -w @auth-boilerplate/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "rebuild:native": "npm rebuild bcrypt esbuild",
    "seed": "npm run seed -w @auth-boilerplate/api",
    "migrate": "npm run migrate -w @auth-boilerplate/api",
    "setup": "npm run setup -w @auth-boilerplate/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.65.0"
  }
}
